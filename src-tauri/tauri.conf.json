{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nothing News Widget",
  "version": "0.2.0",
  "identifier": "es.angelvelasco.nothingnews",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nothing News",
        "width": 360,
        "height": 460,
        "minWidth": 300,
        "minHeight": 260,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
